// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  PRINTER
  MANUFACTURER
  CONSUMER
  ADMIN
}

enum CipponMembershipType {
  INDIVIDUAL
  CORPORATE
  NONE
}

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String?     @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role              UserRole    @default(CONSUMER)
  isVerified        Boolean     @default(false)
  hasCipponMembership Boolean   @default(false)
  cipponMembershipType CipponMembershipType @default(NONE)
  cipponMembershipNumber String?
  cipponLicenseNumber String?
  companyName       String?
  phone             String?
  location          String?
  bio               String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  accounts          Account[]
  sessions          Session[]
  products          Product[]
  initiatedAgreements Agreement[] @relation("initiator")
  receivedAgreements Agreement[] @relation("receiver")
  forumThreads      ForumThread[]
  forumPosts        ForumPost[]
  demoClasses       DemoClass[]
  complaints        Complaint[]
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    String
  images      String   @db.Text // Stored as JSON array of URLs
  contactInfo String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AgreementStatus {
  PROPOSED
  ACTIVE
  COMPLETED
  DISPUTED
}

model Agreement {
  id          String          @id @default(cuid())
  initiatorId String
  initiator   User            @relation("initiator", fields: [initiatorId], references: [id])
  receiverId  String
  receiver    User            @relation("receiver", fields: [receiverId], references: [id])
  status      AgreementStatus @default(PROPOSED)
  terms       String          @db.Text
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  complaints  Complaint[]
}

model ForumCategory {
  id          String        @id @default(cuid())
  name        String
  description String?
  threads     ForumThread[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ForumThread {
  id         String        @id @default(cuid())
  title      String
  content    String        @db.Text
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts      ForumPost[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  likes      Int           @default(0)
}

model ForumPost {
  id        String      @id @default(cuid())
  content   String      @db.Text
  authorId  String
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  likes     Int         @default(0)
}

enum DemoStatus {
  PENDING
  APPROVED
  REJECTED
}

model DemoClass {
  id            String     @id @default(cuid())
  title         String
  description   String     @db.Text
  videoUrl      String?
  schedule      DateTime
  price         Float
  isPaid        Boolean    @default(true)
  status        DemoStatus @default(PENDING)
  manufacturerId String
  manufacturer  User       @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  category      String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Complaint {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  status      String    @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementId String?
  agreement   Agreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  evidence    String?   @db.Text // JSON array of evidence URLs
  resolution  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
